###############################################################################
# QuizPath — Production Environment (cPanel)
# Domain: mediprep.nokkoo.in
###############################################################################

APP_NAME=QuizPath
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mediprep.nokkoo.in
FRONTEND_URL=https://mediprep.nokkoo.in
APP_TIMEZONE=UTC

API_CONTRACT_VERSION=1

###############################################################################
# Database
###############################################################################
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=uddjzwrz_mediprep
DB_USERNAME=uddjzwrz_mediprep
DB_PASSWORD=

###############################################################################
# Cache / Queue / Session
# No Redis on cPanel — use database/file drivers
###############################################################################
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

QUEUE_CONNECTION=database
REDIS_CLIENT=

###############################################################################
# Auth
###############################################################################
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=qp_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_DOMAIN=mediprep.nokkoo.in
REFRESH_COOKIE_SECURE=true
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_REQUIRE_EMAIL_VERIFICATION=false
BCRYPT_ROUNDS=12

CORS_ALLOWED_ORIGINS=https://mediprep.nokkoo.in

###############################################################################
# Storage (local disk on cPanel)
###############################################################################
FILESYSTEM_DISK=local

###############################################################################
# Mail
###############################################################################
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@mediprep.nokkoo.in"
MAIL_FROM_NAME="QuizPath"

###############################################################################
# Logging
###############################################################################
LOG_CHANNEL=single
LOG_LEVEL=warning

###############################################################################
# Web Push (generate with: php artisan quizpath:vapid-keys)
###############################################################################
VAPID_SUBJECT=mailto:support@mediprep.nokkoo.in
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

###############################################################################
# Quiz
###############################################################################
QUIZ_DEFAULT_TIMEZONE=Asia/Kolkata
