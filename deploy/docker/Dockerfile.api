FROM php:8.4-fpm-alpine AS base

# System dependencies
RUN apk add --no-cache \
    nginx supervisor curl icu-libs libzip libpng libjpeg-turbo freetype \
    && apk add --no-cache --virtual .build-deps \
    icu-dev libzip-dev libpng-dev libjpeg-turbo-dev freetype-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) pdo_mysql intl zip gd bcmath opcache pcntl \
    && apk del .build-deps

# Redis extension
RUN apk add --no-cache --virtual .redis-deps $PHPIZE_DEPS \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del .redis-deps

# PHP configuration
COPY deploy/php/opcache.ini /usr/local/etc/php/conf.d/opcache.ini
COPY deploy/php/php-fpm.d/www.conf /usr/local/etc/php-fpm.d/www.conf

# Nginx configuration
COPY deploy/nginx/api.conf /etc/nginx/http.d/default.conf

# Supervisor configuration
COPY deploy/supervisor/api.conf /etc/supervisor.d/api.ini

WORKDIR /var/www/html

# Composer install (cached layer)
COPY api/composer.json api/composer.lock ./
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer \
    && composer install --no-dev --no-scripts --no-autoloader --prefer-dist

# Application code
COPY api/ .

# Finish composer
RUN composer dump-autoload --optimize --classmap-authoritative \
    && php artisan config:cache \
    && php artisan route:cache \
    && php artisan event:cache \
    && php artisan view:cache \
    && chown -R www-data:www-data storage bootstrap/cache

EXPOSE 80

CMD ["supervisord", "-n", "-c", "/etc/supervisord.conf"]
