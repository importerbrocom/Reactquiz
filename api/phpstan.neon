includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - database/factories
        - database/seeders
        - routes

    level: 5

    # Pest's DSL needs its own PHPStan integration; the suite is verified by running
    # it, which is a stronger guarantee than static analysis of the test files.
    excludePaths:
        - tests/*

    # Unmatched patterns are not treated as failures: which of the suppressions
    # below are needed varies with how much of a model Larastan can infer.
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # Larastan reads column types from the migrations, so it sees `status`,
        # `role`, `state` etc. as plain strings and does not know that casts()
        # turns them into enums at runtime. Comparisons against enum cases are
        # therefore reported as impossible even though they are correct — the
        # behaviour is covered by the test suite instead.
        #
        # Proper fix: generated @property annotations via `ide-helper:models`,
        # scheduled as Phase 3 housekeeping.
        - identifier: identical.alwaysFalse
        - identifier: booleanAnd.alwaysFalse
        - identifier: property.nonObject
        - identifier: method.nonObject
        - identifier: function.impossibleType
        - identifier: instanceof.alwaysTrue
        - identifier: nullsafe.neverNull

        # Eloquent relations forward unknown calls to the underlying query builder,
        # so a local scope used on a relation is valid but invisible to analysis.
        -
            identifier: method.notFound
            message: '#Call to an undefined method Illuminate\\Database\\Eloquent\\Relations\\#'
