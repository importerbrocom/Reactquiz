###############################################################################
# Application
###############################################################################
APP_NAME=QuizPath
APP_ENV=local                      # local | testing | staging | production
APP_KEY=                           # php artisan key:generate
APP_DEBUG=true                     # MUST be false outside local
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173 # auth emails link here, not to the API
APP_TIMEZONE=UTC                   # storage timezone — never change after launch
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=cache

# Incremented on additive-but-client-relevant API changes. Sent as X-Api-Contract;
# a mismatch tells the PWA to update its service worker and reload.
API_CONTRACT_VERSION=1

###############################################################################
# Database  (production: MySQL 8.4 in the same region/VPC as the API)
###############################################################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quizpath
DB_USERNAME=quizpath
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci
# Read replica: leave empty until the reporting load justifies one. When set,
# DB_STICKY must stay true or a student can read a stale "day still locked".
DB_READ_HOST=
DB_STICKY=true

###############################################################################
# Cache / queue / session  (production: Redis 7.4)
###############################################################################
CACHE_STORE=redis                  # file is a valid fallback; tags are unavailable
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis              # prefer the extension over predis in production
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=qp_local_
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1                   # separate instance in production, maxmemory-policy noeviction
REDIS_DB=2                         # locks, idempotency, rate limits

###############################################################################
# Authentication
###############################################################################
ACCESS_TOKEN_TTL_MINUTES=15        # held in memory (web) / Keychain (mobile)
REFRESH_TOKEN_TTL_DAYS=30          # rotating, with reuse detection
REFRESH_COOKIE_NAME=qp_refresh
REFRESH_COOKIE_PATH=/api/v1/auth   # scoped: not attached to ordinary API calls
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_SECURE=true         # false only for local http
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_REQUIRE_EMAIL_VERIFICATION=true
AUTH_ADMIN_2FA_REQUIRED=false      # turn on before production launch
ADMIN_IP_ALLOWLIST=                # comma-separated CIDRs; empty disables
BCRYPT_ROUNDS=12

SANCTUM_STATEFUL_DOMAINS=
CORS_ALLOWED_ORIGINS=http://localhost:5173

###############################################################################
# Quiz domain defaults  (per-level values live in the database)
###############################################################################
QUIZ_DEFAULT_TIMEZONE=Asia/Kolkata
QUIZ_DEFAULT_TOTAL_LEVELS=6
QUIZ_DEFAULT_TOTAL_CYCLES=2
QUIZ_DEFAULT_TOTAL_DAYS=30
QUIZ_DEFAULT_DAILY_QUESTIONS=10
QUIZ_DEFAULT_TEST_DAY=31
QUIZ_DEFAULT_PASS_PERCENTAGE=50
QUIZ_DEFAULT_TEST_ATTEMPT_LIMIT=0  # 0 = unlimited
QUIZ_ATTEMPT_ABANDON_HOURS=12
QUIZ_IDEMPOTENCY_TTL_HOURS=24
QUIZ_SUSPICIOUS_SUBMISSIONS_PER_DAY=25

TEST_WINDOW_SIZE=20                # month-end test: questions per windowed fetch
TEST_BATCH_MAX=20                  # answers per batch sync
TEST_GRACE_SECONDS=60

###############################################################################
# Spreadsheet import
###############################################################################
IMPORT_MAX_ROWS=5000
IMPORT_MAX_UPLOAD_MB=10
IMPORT_CHUNK_SIZE=500

###############################################################################
# Storage  (production: S3 / R2 / Spaces — never local disk)
###############################################################################
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_ENDPOINT=                      # set for R2 / Spaces; omit for AWS S3
AWS_USE_PATH_STYLE_ENDPOINT=false
CDN_URL=

###############################################################################
# Web push  (php artisan quizpath:vapid-keys generates a pair)
###############################################################################
VAPID_SUBJECT=mailto:support@example.com
VAPID_PUBLIC_KEY=                  # public by design — served via /bootstrap
VAPID_PRIVATE_KEY=                 # SECRET. Rotating it invalidates all subscriptions

###############################################################################
# Mail
###############################################################################
MAIL_MAILER=log                    # smtp/ses/postmark in production
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# Logging & monitoring
###############################################################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug                    # warning in production
SLOW_QUERY_THRESHOLD_MS=200

###############################################################################
# Seeding (read via config() so a cached config still works)
###############################################################################
SEED_ADMIN_EMAIL=admin@quizpath.test
SEED_ADMIN_NAME="Platform Admin"
SEED_ADMIN_PASSWORD=ChangeMe!2026
